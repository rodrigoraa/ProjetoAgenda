# Substitua o dominio e os caminhos dos certificados antes de publicar.
server {
    listen 80;
    server_name agenda.seudominio.com.br;

    return 308 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name agenda.seudominio.com.br;

    ssl_certificate /etc/letsencrypt/live/agenda.seudominio.com.br/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agenda.seudominio.com.br/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
