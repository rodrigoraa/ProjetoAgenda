# Desenvolvimento local
ENV=development
DEBUG=True
SECRET_KEY=troque-por-uma-chave-local-grande

# Banco local
DATABASE_URI_LOCAL=sqlite:///agendamento.db

# Sessao persistente: professores nao precisam informar CPF a cada acesso
REMEMBER_COOKIE_DAYS=30
SESSION_DAYS=30
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_SAMESITE=Lax

# Administrador inicial
# Ative apenas para bootstrap e desative depois do primeiro acesso.
DEFAULT_ADMIN_ENABLED=True
DEFAULT_ADMIN_NOME=Administrador
DEFAULT_ADMIN_MATRICULA=00000000000
DEFAULT_ADMIN_SENHA=admin123
# Producao
# ENV=production
# DEBUG=False
# SECRET_KEY=gere_uma_chave_com_python_-c_import_secrets
# SESSION_COOKIE_SECURE=True
# SESSION_COOKIE_SAMESITE=Lax
# FORCE_HTTPS=True
# TRUST_PROXY_HEADERS=True
# TRUSTED_HOSTS=agenda.seudominio.com.br
# PROXY_FIX_X_FOR=1
# PROXY_FIX_X_PROTO=1
# PROXY_FIX_X_HOST=1
# PROXY_FIX_X_PORT=1
